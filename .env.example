# ==========================================
# TeamHQ Production Environment Configuration
# ==========================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Session Encryption Secret (Min 32 characters, generate with: openssl rand -base64 32)
AUTH_SECRET=your_32_character_cryptographic_secret_here

# Database Connection URI (PostgreSQL for production, SQLite for local dev)
# Example PostgreSQL: postgresql://user:password@localhost:5432/teamhq?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/teamhq?schema=public

# Application Base URL
APP_URL=https://teamhq.example.com

# Optional Initial Admin Account (used during seed script initialization)
ADMIN_EMAIL=admin@teamhq.com
ADMIN_PASSWORD=change_this_to_a_strong_password
