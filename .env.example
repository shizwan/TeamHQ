# ==========================================
# TeamHQ Environment Configuration Template
# ==========================================

# Application Environment ('development' | 'production')
NODE_ENV=development

# Server Session Encryption Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=teamhq_production_grade_secret_key_at_least_32_chars_long!

# Admin Credentials
ADMIN_EMAIL=admin@teamhq.com
ADMIN_PASSWORD=password

# Developer Admin Secret (for local seed operations)
ADMIN_SECRET=teamhq-dev-secret

# Database Connection (SQLite local file or PostgreSQL connection URI)
DATABASE_URL="file:./dev.db"
