// PostgreSQL Production Schema for TeamHQ
// For Vercel Postgres / Supabase / Neon deployments:
// Set DATABASE_URL="postgresql://username:password@host:port/database?schema=public"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("MEMBER") // 'ADMIN' | 'MANAGER' | 'MEMBER' | 'VIEWER'
  active       Boolean   @default(true)
  workspaceId  String    @default("default-workspace")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([email])
}

model Workspace {
  id          String       @id @default("default-workspace")
  name        String       @default("TeamHQ Workspace")
  slug        String       @unique @default("teamhq")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  teamMembers TeamMember[]
  projects    Project[]
  tasks       Task[]
  activity    ActivityLog[]
}

model TeamMember {
  id          String    @id @default(uuid())
  workspaceId String    @default("default-workspace")
  userId      String?
  name        String
  role        String
  department  String?
  status      String    @default("Active") // 'Active' | 'Inactive'
  manager     String?   @default("Shizwan")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  tasks       Task[]     @relation("TeamMemberTasks")

  @@index([workspaceId])
  @@index([status])
}

model Project {
  id          String    @id @default(uuid())
  workspaceId String    @default("default-workspace")
  title       String
  description String?
  priority    String    @default("High") // 'Critical' | 'High' | 'Medium' | 'Low'
  status      String    @default("Active") // 'Active' | 'Completed' | 'Archived'
  leadOwner   String?   @default("Shizwan")
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  tasks       Task[]     @relation("ProjectTasks")

  @@index([workspaceId])
  @@index([status])
}

model Task {
  id              String    @id @default(uuid())
  deliverableId   String?   // e.g. DLV-000001
  workspaceId     String    @default("default-workspace")
  userId          String    @default("admin-user")
  projectId       String
  assigneeId      String
  title           String
  status          String    @default("In Progress") // 'In Progress' | 'Completed' | 'Carried Forward' | 'Cancelled' | 'Blocked'
  slipCause       String?   @default("N/A") // 'N/A' | 'Developer' | 'Dependency' | 'Scope Drift' | 'Environment/QA' | 'Unplanned Task'
  startDate       DateTime?
  targetDueDate   DateTime?
  targetDueTime   String?   @default("10:00 PM") // ETA (01:00 PM to 10:00 PM)
  completedDate   DateTime?
  completedTime   String?   // 01:00 PM to 10:00 PM
  daysActive      Int       @default(1)
  delayHours      Float     @default(0)
  onTimeStatus    String    @default("Pending") // 'Yes' | 'No' | 'Unverified' | 'Pending'
  lifecycleStatus String    @default("🟢 In Progress")
  labels          String?   @default("[]")
  checklist       String?   @default("[]")
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace?  @relation(fields: [workspaceId], references: [id])
  project   Project     @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: Cascade)
  assignee  TeamMember  @relation("TeamMemberTasks", fields: [assigneeId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([targetDueDate])
  @@index([deliverableId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId String   @default("default-workspace")
  userId      String   @default("admin-user")
  actorName   String   @default("Shizwan")
  actorEmail  String?  @default("shizwan@teamhq.io")
  action      String   // 'created' | 'updated' | 'status_changed' | 'completed' | 'deleted' | 'archived' | 'unarchived'
  entityType  String   // 'task' | 'project' | 'team_member' | 'system'
  entityId    String?
  entityTitle String
  details     String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([entityType])
  @@index([createdAt])
}
