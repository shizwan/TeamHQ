# TeamHQ local development environment (example values only).
# Copy to .env for Prisma CLI access and optionally .env.local for Next.js.
# Do not commit files containing real credentials.

NODE_ENV=development

# Generate a unique secret: openssl rand -base64 32
AUTH_SECRET=replace_with_unique_long_random_development_secret

# Default Prisma schema uses PostgreSQL, not SQLite.
DATABASE_URL=postgresql://localuser:localpassword@localhost:5432/teamhq_dev?schema=public

APP_URL=http://localhost:3000

# Only used for authorized, destructive local demo seeding.
ADMIN_EMAIL=admin@teamhq.local
ADMIN_PASSWORD=replace_with_a_unique_long_password
# Explicitly set CONFIRM_DEMO_SEED only when you intend to reset a disposable workspace.
# CONFIRM_DEMO_SEED=YES_DELETE_WORKSPACE_DATA
